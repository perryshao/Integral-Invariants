# Normalise line endings on commit.  The original workspace was Windows MATLAB,
# so most .m files still carry CRLF; this converts them to LF in the repository
# while leaving each working copy native.
* text=auto eol=lf

*.m      text
*.c      text
*.cpp    text
*.h      text
*.md     text
*.sh     text eol=lf

# Prebuilt MEX binaries are tracked on purpose -- MelkmanConvexHull
# has no surviving source, so the binaries are the only copy.  Never let git
# apply newline translation to them.
*.mex*       binary
*.mexw32     binary
*.mexw64     binary
*.mexa64     binary
*.mexmaci64  binary
*.dll        binary
*.manifest   binary

# Keep GitHub's language statistics about *this* project rather than about the
# bundled toolboxes.
thirdparty/** linguist-vendored
