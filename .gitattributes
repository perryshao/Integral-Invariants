# Normalise line endings on commit.  The original workspace was Windows MATLAB,
# so most .m files still carry CRLF; this converts them to LF in the repository
# and checks text files out as LF on every platform.
* text=auto eol=lf

*.m      text
*.c      text
*.cpp    text
*.h      text
*.md     text
*.sh     text eol=lf

# Preserve the historical prebuilt MEX binaries independently of recovered
# source and new test builds. Never apply newline translation to binaries.
*.mex*       binary
*.mexw32     binary
*.mexw64     binary
*.mexa64     binary
*.mexmaci64  binary
*.dll        binary
*.manifest   binary

# Keep GitHub's language statistics about *this* project rather than about the
# bundled toolboxes.
thirdparty/** linguist-vendored

# Keep recovered source archives byte-for-byte; they are not active code.
legacy/** -text linguist-vendored
